# Public domain (without protocol)
DOMAIN=example.com

# Docker image prefix (optional, set by CI/CD for GHCR) and tag
IMAGE_PREFIX=
IMAGE_TAG=latest

# PostgreSQL credentials
POSTGRES_DB=pinveria
POSTGRES_USER=pinveria
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Optional one-time administrator bootstrap credentials (supply only on first startup with an empty DB, then clear)
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
